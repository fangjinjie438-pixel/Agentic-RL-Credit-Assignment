#!/bin/sh
# Project C compiler entry for Triton launchers. Receives clang-style arguments
# and calls only the project's Python/ziglang; outputs the requested object/DSO.
set -eu
wrapper_directory=${0%/*}
project_directory=$(CDPATH= cd -- "$wrapper_directory/../.." && pwd)
export ZIG_GLOBAL_CACHE_DIR="$project_directory/.cache/zig/global"
export ZIG_LOCAL_CACHE_DIR="$project_directory/.cache/zig/local"
exec "$project_directory/.venv-toolchain/bin/python" -m ziglang cc "$@"
